                .setNegativeButton("Ne", null)
                .setPositiveButton("Smazat", (dialog, which) -> {
                    setBottomStatus("Mažu " + name + "…", MUTED);
                    String request = "/delete?disk=" + enc(filesDisk) + "&p=" + enc(filesPath) + "&f=" + enc(path);
                    api.getText(request, (result, 